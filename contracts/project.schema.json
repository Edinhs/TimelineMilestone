{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stellantis.local/timeline-studio/project.schema.json",
  "title": "TimelineStudio Project",
  "description": "Contrato único do projeto. TODA a aplicação (UI, engine de render, exportadores, importador .xlsm) fala este formato. Congelado na Wave 0 — mudanças exigem bump de schema_version.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "milestones",
    "components",
    "activities"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5",
        "1.6"
      ],
      "description": "1.1 project.layout · 1.2 components[].supplier · 1.3 project.legend · 1.4 project.owner · 1.5 project.deck · 1.6 role/locked em elementos de slide. Todos opcionais e aditivos."
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "chart_start",
        "chart_end"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "last_update": {
          "type": "string",
          "description": "Rótulo livre, ex.: 'August/2026'. Se ausente, gerado na exportação."
        },
        "chart_start": {
          "type": "string",
          "format": "date",
          "description": "Primeiro dia visível do eixo (será arredondado para o 1o do mês)."
        },
        "chart_end": {
          "type": "string",
          "format": "date"
        },
        "today": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "null = usa a data do sistema."
        },
        "show_today_line": {
          "type": "boolean",
          "default": true
        },
        "duration_unit": {
          "enum": [
            "W",
            "M",
            "none"
          ],
          "default": "W"
        },
        "logo_path": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "layout": {
          "type": "object",
          "description": "Dimensões do desenho, por projeto. Todo campo é opcional; ausente = padrão de SPEC-002 §2. Valores fora da faixa são fixados no limite, nunca rejeitados.",
          "additionalProperties": false,
          "properties": {
            "month_w": {
              "type": "number",
              "minimum": 10,
              "maximum": 72,
              "default": 24,
              "description": "Largura de um mês no eixo, em px."
            },
            "row_h": {
              "type": "number",
              "minimum": 10,
              "maximum": 40,
              "default": 16,
              "description": "Altura de uma lane, em px."
            },
            "bar_h": {
              "type": "number",
              "minimum": 5,
              "maximum": 30,
              "default": 11,
              "description": "Altura da barra. Fixada em row_h-2 se exceder."
            },
            "panel_w": {
              "type": "number",
              "minimum": 80,
              "maximum": 320,
              "default": 150,
              "description": "Largura do painel de nomes de componente, em px."
            },
            "band_h": {
              "type": "number",
              "minimum": 60,
              "maximum": 220,
              "default": 112,
              "description": "Altura da faixa de marcos e legenda, em px."
            },
            "font_scale": {
              "type": "number",
              "minimum": 0.7,
              "maximum": 2,
              "default": 1,
              "description": "Multiplicador aplicado a todo texto do display list."
            }
          }
        },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "description": "Aparência da caixa 'Components'. As CHAVES de status são fixas (o enum de activities[].status depende delas); o que é editável é nome e cor.",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30,
              "default": "Components",
              "description": "Título da caixa de legenda."
            },
            "hidden": {
              "type": "boolean",
              "default": false,
              "description": "Oculta a caixa inteira."
            },
            "statuses": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ontime": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Sobrescreve a aparência de um status. Campo ausente = padrão de SPEC-002 §3. Cor inválida é ignorada e cai no padrão, nunca rejeita o arquivo.",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "description": "Nome exibido na legenda e nos seletores. Não altera a chave do status."
                    },
                    "fill": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Preenchimento da barra."
                    },
                    "stroke": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Contorno da barra."
                    },
                    "text": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Cor do rótulo dentro da barra."
                    },
                    "hidden": {
                      "type": "boolean",
                      "default": false,
                      "description": "Omite a linha da caixa de legenda. As barras desse status continuam sendo desenhadas."
                    }
                  }
                },
                "delayed": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Sobrescreve a aparência de um status. Campo ausente = padrão de SPEC-002 §3. Cor inválida é ignorada e cai no padrão, nunca rejeita o arquivo.",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "description": "Nome exibido na legenda e nos seletores. Não altera a chave do status."
                    },
                    "fill": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Preenchimento da barra."
                    },
                    "stroke": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Contorno da barra."
                    },
                    "text": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Cor do rótulo dentro da barra."
                    },
                    "hidden": {
                      "type": "boolean",
                      "default": false,
                      "description": "Omite a linha da caixa de legenda. As barras desse status continuam sendo desenhadas."
                    }
                  }
                },
                "concluded": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Sobrescreve a aparência de um status. Campo ausente = padrão de SPEC-002 §3. Cor inválida é ignorada e cai no padrão, nunca rejeita o arquivo.",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "description": "Nome exibido na legenda e nos seletores. Não altera a chave do status."
                    },
                    "fill": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Preenchimento da barra."
                    },
                    "stroke": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Contorno da barra."
                    },
                    "text": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Cor do rótulo dentro da barra."
                    },
                    "hidden": {
                      "type": "boolean",
                      "default": false,
                      "description": "Omite a linha da caixa de legenda. As barras desse status continuam sendo desenhadas."
                    }
                  }
                },
                "concluded_delay": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Sobrescreve a aparência de um status. Campo ausente = padrão de SPEC-002 §3. Cor inválida é ignorada e cai no padrão, nunca rejeita o arquivo.",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "description": "Nome exibido na legenda e nos seletores. Não altera a chave do status."
                    },
                    "fill": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Preenchimento da barra."
                    },
                    "stroke": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Contorno da barra."
                    },
                    "text": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Cor do rótulo dentro da barra."
                    },
                    "hidden": {
                      "type": "boolean",
                      "default": false,
                      "description": "Omite a linha da caixa de legenda. As barras desse status continuam sendo desenhadas."
                    }
                  }
                },
                "attention": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Sobrescreve a aparência de um status. Campo ausente = padrão de SPEC-002 §3. Cor inválida é ignorada e cai no padrão, nunca rejeita o arquivo.",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "description": "Nome exibido na legenda e nos seletores. Não altera a chave do status."
                    },
                    "fill": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Preenchimento da barra."
                    },
                    "stroke": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Contorno da barra."
                    },
                    "text": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "description": "Cor do rótulo dentro da barra."
                    },
                    "hidden": {
                      "type": "boolean",
                      "default": false,
                      "description": "Omite a linha da caixa de legenda. As barras desse status continuam sendo desenhadas."
                    }
                  }
                }
              }
            }
          }
        },
        "owner": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 60,
          "description": "Responsável pela criação e manutenção do cronograma. Aparece no cabeçalho do desenho, ao lado do rótulo de última atualização. null ou ausente = linha omitida."
        },
        "deck": {
          "type": "object",
          "additionalProperties": false,
          "description": "Apresentação do projeto. Vive dentro do documento para viajar junto com ele (ADR-006 §1).",
          "properties": {
            "theme": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "accent": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "bg": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "fg": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "font": {
                  "type": "string",
                  "maxLength": 40
                }
              }
            },
            "slides": {
              "type": "array",
              "maxItems": 60,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "elements"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "layout": {
                    "enum": [
                      "cover",
                      "title",
                      "content",
                      "chart",
                      "table",
                      "blank"
                    ],
                    "default": "content"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "bg": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "elements": {
                    "type": "array",
                    "maxItems": 40,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "type",
                        "x",
                        "y",
                        "w",
                        "h"
                      ],
                      "description": "Elemento de slide. Coordenadas em px no palco de 960×540 (16:9); a exportação converte para EMU.",
                      "properties": {
                        "id": {
                          "type": "string",
                          "maxLength": 32
                        },
                        "type": {
                          "enum": [
                            "text",
                            "image",
                            "shape",
                            "table",
                            "chart"
                          ]
                        },
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "w": {
                          "type": "number",
                          "minimum": 8
                        },
                        "h": {
                          "type": "number",
                          "minimum": 8
                        },
                        "z": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 4000
                        },
                        "size": {
                          "type": "number",
                          "minimum": 6,
                          "maximum": 96
                        },
                        "bold": {
                          "type": "boolean"
                        },
                        "align": {
                          "enum": [
                            "l",
                            "ctr",
                            "r"
                          ]
                        },
                        "color": {
                          "type": "string",
                          "pattern": "^#[0-9A-Fa-f]{6}$"
                        },
                        "src": {
                          "type": "string",
                          "description": "Imagem embutida como data URI PNG/JPEG. Ver ADR-006 §3 sobre tamanho de arquivo."
                        },
                        "shape": {
                          "enum": [
                            "rect",
                            "roundRect",
                            "ellipse",
                            "line"
                          ]
                        },
                        "fill": {
                          "type": "string",
                          "pattern": "^#[0-9A-Fa-f]{6}$"
                        },
                        "stroke": {
                          "type": "string",
                          "pattern": "^#[0-9A-Fa-f]{6}$"
                        },
                        "rows": {
                          "type": "array",
                          "maxItems": 40,
                          "items": {
                            "type": "array",
                            "maxItems": 10,
                            "items": {
                              "type": "string",
                              "maxLength": 200
                            }
                          }
                        },
                        "header": {
                          "type": "boolean",
                          "description": "Primeira linha da tabela é cabeçalho."
                        },
                        "role": {
                          "type": "string",
                          "maxLength": 24,
                          "description": "Papel do elemento dentro do layout (ex.: cover-title). Usado para reaplicar layout sem duplicar elementos e para identificar as partes travadas da capa."
                        },
                        "locked": {
                          "type": "boolean",
                          "default": false,
                          "description": "Elemento do template: não pode ser movido, redimensionado nem removido. O texto continua editável."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "description": "Marcos globais do projeto: linha vertical tracejada em toda a altura do gráfico (PM, CM, SFM, SHRM, SOPM, X0..X3).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "date",
          "style"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,24}$"
          },
          "label": {
            "type": "string",
            "maxLength": 16
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "style": {
            "enum": [
              "gate",
              "xgate",
              "today",
              "custom"
            ],
            "description": "gate = dourado tracejado (PM/CM/SFM/SHRM/SOPM); xgate = navy tracejado com triângulo (X0..X3)."
          },
          "show_line": {
            "type": "boolean",
            "default": true
          },
          "show_marker": {
            "type": "boolean",
            "default": false
          },
          "color_override": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 240
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "description": "Agrupamento vertical (a coluna '1', '2' à esquerda no arquivo de referência). Opcional.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "maxLength": 16
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "components": {
      "type": "array",
      "description": "Faixas horizontais nomeadas à esquerda (Audio base, Cluster 7\" & 10\", DCSD 12.3\"...).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "group_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "collapsed": {
            "type": "boolean",
            "default": false
          },
          "supplier": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60,
            "description": "Fornecedor responsável pelo componente. Campo de organização e auditoria: não altera o desenho. null ou ausente = não informado (gera achado A201)."
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "description": "Barras do Gantt. Uma atividade pertence a um componente e ocupa uma 'lane' (linha) dentro dele.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "component_id",
          "name",
          "start",
          "end",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "component_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 60,
            "description": "Ex.: 'SW Development', 'DV Testing', 'Sourcing'."
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "ontime",
              "delayed",
              "concluded",
              "concluded_delay",
              "attention"
            ],
            "description": "Mapeia 1:1 a legenda 'Components' do arquivo de referência."
          },
          "lane": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Linha dentro do componente. Duas atividades na mesma lane não podem se sobrepor."
          },
          "show_duration": {
            "type": "boolean",
            "default": true
          },
          "duration_unit_override": {
            "enum": [
              "W",
              "M",
              "none",
              null
            ],
            "default": null
          },
          "label_position": {
            "enum": [
              "inside",
              "above",
              "right"
            ],
            "default": "inside"
          },
          "markers": {
            "type": "array",
            "description": "Marcadores triangulares ancorados na barra (OT Parts, DTOP, PPAP, Kick off, SW Full feature, SW Bug free).",
            "items": {
              "type": "object",
              "required": [
                "label",
                "date"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 24
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "shape": {
                  "enum": [
                    "triangle_down",
                    "diamond",
                    "flag"
                  ],
                  "default": "triangle_down"
                },
                "color": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
